generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Card {
  id           Int      @id @default(autoincrement())
  name         String
  set          String
  game         String
  rarity       String
  quantity     Int      @default(1)
  dateScanned  DateTime @default(now())

  @@unique([name, set, game, rarity])
}
